# ==============================================================================
# AireProject Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# NEVER commit your actual .env containing real secrets to source control.
# ==============================================================================

# ── Frontend Configuration (Vite) ─────────────────────────────────────────────
# Set to 'true' to force mock data during local offline frontend development/tests.
# Must be 'false' in production so live Open-Meteo observations and CPCB calculations are used.
VITE_USE_MOCK_AQI=false

# URL of the backend API server (FastAPI).
# In local development: http://localhost:8000
# In Docker production setup: /api (proxied via Nginx)
VITE_ML_BACKEND_URL=http://localhost:8000

# Optional: Override URL for authentication & user endpoints (defaults to VITE_ML_BACKEND_URL if unset).
VITE_AUTH_BACKEND_URL=http://localhost:8000

# Optional: Carto basemap API key (https://carto.com/basemaps/apikey/).
# Leave blank to use OpenStreetMap standard tiles directly without an API key.
VITE_CARTO_KEY=

# ── Backend Configuration (FastAPI / Uvicorn) ─────────────────────────────────
# Deployment environment: 'development' or 'production'
ENVIRONMENT=development

# Secret key used for signing session JWT tokens.
# IN PRODUCTION: Generate a cryptographically secure random string with at least 32 bytes:
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Session token validity duration in minutes (default: 10080 minutes = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Whether session cookies require HTTPS ('true' for production HTTPS deployments, 'false' for local HTTP).
COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins for the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80

# Database connection URL.
# SQLite default: sqlite:///ml_pipeline/data/aire_users.db
# PostgreSQL example: postgresql://aire_user:secure_password@localhost:5432/aire_db
DATABASE_URL=sqlite:///ml_pipeline/data/aire_users.db

# ── Optional Data Collection (Offline ML Pipeline Only) ───────────────────────
# Free key from https://docs.openaq.org/using-the-api/api-key
# Only required if re-running ml_pipeline/collect_data.py to harvest new training data.
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY_HERE
