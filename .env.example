# ── Map tiles ─────────────────────────────────────────────────────────────────
# Optional: free key from https://carto.com/basemaps/apikey/ for a cleaner basemap.
# Leave empty to use OpenStreetMap.
VITE_CARTO_KEY=

# ── ML Backend ────────────────────────────────────────────────────────────────
# URL of the FastAPI prediction server (ml_pipeline/serve.py).
# Leave empty to use the built-in deterministic mock instead.
# Start the server with: uvicorn ml_pipeline.serve:app --reload --port 8000
VITE_ML_BACKEND_URL=http://localhost:8000

# ── OpenAQ API Key (used only by the Python ML pipeline, NOT by the frontend) ─
# Free key from: https://docs.openaq.org/using-the-api/api-key
# Set this before running: python ml_pipeline/collect_data.py
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY_HERE
